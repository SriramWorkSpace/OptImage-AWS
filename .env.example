# Environment Variables Template
# Copy this file to .env.local and fill in your AWS credentials

# AWS Configuration (only needed for gallery functionality)
# You can also use IAM roles instead of access keys when deployed
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=image-resizer-demo-sriram

# Optional: Spline 3D scene embed URL for homepage hero
# Example: https://prod.spline.design/xxxx/scene.splinecode or an iframe URL
NEXT_PUBLIC_SPLINE_SCENE_URL=
